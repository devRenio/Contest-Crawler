# Google AI Studio 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 기본 분류 모델 / 애매 건 재분류 모델
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_REVIEW=gemini-2.5-flash

# sqlite:///./data/contests.db 또는 postgresql+psycopg://...
DATABASE_URL=sqlite:///./data/contests.db

# 동아리 사이트 도메인 (CORS). 여러 개는 쉼표로.
CORS_ORIGINS=http://localhost:3000,https://goorm.net,https://www.goorm.net

API_HOST=127.0.0.1
API_PORT=8000
